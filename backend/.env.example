# Copy to backend/.env for local development. Never commit .env.

# Secret mixed into the daily seeds. Use a long random value in production
# (python -c "import secrets; print(secrets.token_hex(32))") and keep it stable:
# changing it changes every day's records.
SURVEILLED_DAILY_SALT=local-development-salt-not-secret

# Day 1 of the daily game.
SURVEILLED_LAUNCH_DAY=2026-11-16

# True in production, where the site is served over HTTPS.
SURVEILLED_COOKIE_SECURE=false

# Developer tools, such as resetting your own day after being locked out. Never true in production.
SURVEILLED_DEV_MODE=true

# Supabase, for comparing each finished day with everyone else's. Leave both empty to run without
# standings (the report then says rankings are unavailable). From the Supabase dashboard:
# Project Settings > Data API (the URL) and Project Settings > API Keys (the secret key).
# The secret key bypasses row level security: it stays in backend/.env and never reaches the browser.
SURVEILLED_SUPABASE_URL=
SURVEILLED_SUPABASE_SECRET_KEY=

# Finished days needed before a standing shows as a percentage. 1 is handy in development.
SURVEILLED_STANDING_MIN_PLAYERS=1
